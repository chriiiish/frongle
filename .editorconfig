root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.cs]
indent_size = 4

[**/Migrations/*.cs]
generated_code = true

[*.cs]
# Test and API names read better without these rules
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
