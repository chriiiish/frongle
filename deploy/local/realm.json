{
  "realm": "frongle",
  "enabled": true,
  "sslRequired": "external",
  "loginTheme": "frongle",
  "displayName": "Frongle",
  "roles": {
    "realm": [
      {
        "name": "maintenance-manager"
      },
      {
        "name": "work-team"
      }
    ]
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"tenant_id\", \"displayName\": \"Tenant\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}}]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "frongle-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost/*", "http://localhost:5173/*"],
      "webOrigins": ["http://localhost", "http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "manager@acme.test",
      "enabled": true,
      "email": "manager@acme.test",
      "firstName": "Morgan",
      "lastName": "Manager",
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["acme"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["maintenance-manager"],
      "clientRoles": {
        "account": ["view-profile", "manage-account"]
      }
    },
    {
      "username": "team@acme.test",
      "enabled": true,
      "email": "team@acme.test",
      "firstName": "Taylor",
      "lastName": "Team",
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["acme"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["work-team"],
      "clientRoles": {
        "account": ["view-profile", "manage-account"]
      }
    },
    {
      "username": "manager@globex.test",
      "enabled": true,
      "email": "manager@globex.test",
      "firstName": "Glenn",
      "lastName": "Globex",
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["globex"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["maintenance-manager"],
      "clientRoles": {
        "account": ["view-profile", "manage-account"]
      }
    }
  ]
}
